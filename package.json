{
  "name": "opossum",
  "version": "0.1.0",
  "description": "Operational Polling and Observation of Systems, Services, Uptime, and Machines",
  "main": "out/main/index.js",
  "author": "Mike Wennersten",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:portable": "npm run build && electron-builder --win portable --x64",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:icon": "node scripts/generate-icon.mjs",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.3",
    "lucide-react": "^0.542.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^7.16.0",
    "yaml": "^2.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.6.2",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
